node_modules/
dist/
target/
release/
localai-service/bundle/
localai-service/wheels/
localai-service/test-output/
__pycache__/
*.tsbuildinfo
.build-inputs/
model-cache/
model-candidates/

# Public runtime binaries are shipped in the verified release ZIP, not Git.
# Keep the small provenance manifests and license texts beside the source.
localai-service/public-voice/**
!localai-service/public-voice/**/
!localai-service/public-voice/**/*.json
!localai-service/public-voice/**/*.txt
localai-service/public-voice-candidate/
localai-service/public-voice-uzbek/
localai-service/public-tools/*.exe
localai-service/public-tools/*.tar.gz

# Per-user state and generated recordings must never enter a source release.
localai-service/config/
localai-service/data/
localai-service/logs/
localai-service/captures/
localai-service/workspace/
*.session
*.session-journal
*.dpapi
*.wav
*.pcm
!assets/qanot/sounds/*.wav

# Generated by tauri-build on every compile
src-tauri/gen/schemas/

# Local secrets and overrides — never committed.
.env
.env.*
!.env.example
