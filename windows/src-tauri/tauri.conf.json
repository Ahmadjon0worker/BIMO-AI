{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coucou",
  "version": "0.6.2",
  "identifier": "fr.louisraille.coucou",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Coucou",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/coucou-hook.exe": "coucou-hook.exe",
      "../localai-service/bundle/": "localai-service/",
      "../INSTALL-UZ.md": "INSTALL-UZ.md"
    },
    "copyright": "© Louis Raille",
    "category": "DeveloperTool",
    "shortDescription": "Coucou AI: Ollama, Gemini, Groq and desktop tools",
    "longDescription": "Windows AI assistant with automatic Ollama, Gemini and Groq provider selection, Codex status, a flexible desktop panel, Telegram and computer controls.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Uzbek",
          "English",
          "Russian",
          "French"
        ],
        "customLanguageFiles": {
          "Uzbek": "nsis/Uzbek.nsh"
        },
        "displayLanguageSelector": true,
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
