; Tauri installer messages in Uzbek. Keep identifiers and NSIS placeholders intact.
LangString addOrReinstall ${LANG_UZBEK} "Qismlarni qo'shish yoki qayta o'rnatish"
LangString alreadyInstalled ${LANG_UZBEK} "Dastur allaqachon o'rnatilgan"
LangString alreadyInstalledLong ${LANG_UZBEK} "${PRODUCTNAME} ${VERSION} allaqachon o'rnatilgan. Kerakli amalni tanlang va davom etish uchun Keyingi tugmasini bosing."
LangString appRunning ${LANG_UZBEK} "{{product_name}} ishlayapti! Avval dasturni yoping, keyin yana urinib ko'ring."
LangString appRunningOkKill ${LANG_UZBEK} "{{product_name}} ishlayapti!$\nUni yopish uchun OK tugmasini bosing."
LangString chooseMaintenanceOption ${LANG_UZBEK} "Bajariladigan xizmat amalini tanlang."
LangString choowHowToInstall ${LANG_UZBEK} "${PRODUCTNAME} dasturini qanday o'rnatishni tanlang."
LangString createDesktop ${LANG_UZBEK} "Ish stolida yorliq yaratish"
LangString dontUninstall ${LANG_UZBEK} "Mavjud dasturni o'chirmaslik"
LangString dontUninstallDowngrade ${LANG_UZBEK} "Mavjud dasturni o'chirmaslik (avval uni o'chirmasdan eski versiyani o'rnatish taqiqlangan)"
LangString failedToKillApp ${LANG_UZBEK} "{{product_name}} dasturini yopib bo'lmadi. Avval uni o'zingiz yoping, keyin yana urinib ko'ring."
LangString installingWebview2 ${LANG_UZBEK} "WebView2 o'rnatilmoqda..."
LangString newerVersionInstalled ${LANG_UZBEK} "${PRODUCTNAME} dasturining yangiroq versiyasi allaqachon o'rnatilgan! Eski versiyani o'rnatish tavsiya etilmaydi. Eski versiya kerak bo'lsa, avval mavjud versiyani o'chirgan ma'qul. Kerakli amalni tanlang va davom etish uchun Keyingi tugmasini bosing."
LangString older ${LANG_UZBEK} "eski"
LangString olderOrUnknownVersionInstalled ${LANG_UZBEK} "Kompyuteringizda ${PRODUCTNAME} dasturining $R4 versiyasi o'rnatilgan. O'rnatishdan avval mavjud versiyani o'chirish tavsiya etiladi. Kerakli amalni tanlang va davom etish uchun Keyingi tugmasini bosing."
LangString silentDowngrades ${LANG_UZBEK} "Bu o'rnatuvchida eski versiyaga qaytish taqiqlangan. Yashirin o'rnatishni davom ettirib bo'lmaydi; oynali o'rnatuvchidan foydalaning.$\n"
LangString unableToUninstall ${LANG_UZBEK} "Dasturni o'chirib bo'lmadi!"
LangString uninstallApp ${LANG_UZBEK} "${PRODUCTNAME} dasturini o'chirish"
LangString uninstallBeforeInstalling ${LANG_UZBEK} "O'rnatishdan avval mavjud dasturni o'chirish"
LangString unknown ${LANG_UZBEK} "noma'lum"
LangString webview2AbortError ${LANG_UZBEK} "WebView2 o'rnatilmadi! Usiz dastur ishlay olmaydi. O'rnatuvchini qayta ishga tushirib ko'ring."
LangString webview2DownloadError ${LANG_UZBEK} "Xato: WebView2 yuklab olinmadi — $0"
LangString webview2DownloadSuccess ${LANG_UZBEK} "WebView2 o'rnatish dasturi yuklab olindi"
LangString webview2Downloading ${LANG_UZBEK} "WebView2 o'rnatish dasturi yuklab olinmoqda..."
LangString webview2InstallError ${LANG_UZBEK} "Xato: WebView2 o'rnatilmadi. Chiqish kodi: $1"
LangString webview2InstallSuccess ${LANG_UZBEK} "WebView2 o'rnatildi"
LangString deleteAppData ${LANG_UZBEK} "Dastur ma'lumotlarini o'chirish"
